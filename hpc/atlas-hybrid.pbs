#!/bin/bash
#PBS -N p3_hybrid
#PBS -q parallel
#PBS -j oe
#PBS -l select=1:ncpus=12:mpiprocs=12:ompthreads=1:mem=8gb
#PBS -l walltime=00:30:00

set -eo pipefail
cd "$PBS_O_WORKDIR"
atlas_results="$PBS_O_WORKDIR/results/atlas-hybrid.$PBS_JOBID"
mkdir -p "$atlas_results"
trap 'atlas_status=$?; printf "exit_status=%s\n" "$atlas_status" > "$atlas_results/status.txt"' EXIT
source /etc/profile.d/modules.sh
module purge
module load miniconda/4.12
module load openmpi/4.1.2
module load gcc/9.2.0
atlas_cxx=$(command -v g++)
atlas_python=$(command -v python3)
[[ $("$atlas_cxx" -dumpfullversion -dumpversion) == 9.2.0 ]]
export OMPI_CXX="$atlas_cxx"
"$atlas_python" -c 'import sys; print(sys.version); sys.exit(0 if sys.version_info >= (3,8) else "Python 3.8+ required")'
unset OMP_NUM_THREADS OMP_PLACES OMP_PROC_BIND GOMP_CPU_AFFINITY KMP_AFFINITY
export OMP_DYNAMIC=FALSE
{
  hostname
  module list
  "$atlas_cxx" --version
  mpicxx --showme:command
  mpirun --version
  "$atlas_python" --version
  lscpu
  taskset -pc $$
  cat "$PBS_NODEFILE"
} > "$atlas_results/environment.txt" 2>&1

echo 'Stage 1: Rebuild K-means and the separate Linux/OpenMP placement probe.'
make -B all CXX="$atlas_cxx" MPICXX=mpicxx
"$atlas_cxx" -O2 -std=c++17 -Wall -Wextra -Wpedantic -fopenmp atlas-thread-probe.cpp -o build/atlas-thread-probe
sha256sum build/kmeans_serial build/kmeans_mpi build/atlas-thread-probe > "$atlas_results/binaries.sha256"
"$atlas_python" atlas-affinity.py snapshot --expected-cores 12 > "$atlas_results/allocation.json"
"$atlas_python" atlas-hybrid-launch.py plan "$atlas_results/allocation.json" "$atlas_results/layout-plan.json"
export KMEANS_BINDING_NOTE="Explicit per-rank OS masks and singleton OMP_PLACES; see layout-plan.json and per-launch placement records"

echo 'Stage 2: Probe every P/T layout and validate small-data results.'
./build/kmeans_serial --n 37 --d 3 --k 4 --seed 42 --iterations 5 --warmup 2 --dump > "$atlas_results/preflight-serial.json"
for atlas_p in 1 2 3 4 6 12; do
  atlas_t=$((12 / atlas_p))
  "$atlas_python" atlas-hybrid-launch.py run --plan "$atlas_results/layout-plan.json" \
    --p "$atlas_p" --t "$atlas_t" --probe "$PBS_O_WORKDIR/build/atlas-thread-probe" \
    --output "$atlas_results/preflight-placements" --nodefile "$PBS_NODEFILE" -- \
    "$PBS_O_WORKDIR/build/kmeans_mpi" --n 37 --d 3 --k 4 --seed 42 \
    --iterations 5 --warmup 2 --variant v3 --threads "$atlas_t" --comm allreduce --dump \
    > "$atlas_results/preflight-p$atlas_p.json" 2> "$atlas_results/preflight-p$atlas_p.stderr.log"
done
"$atlas_python" - "$atlas_results" <<'PY'
import json,math,sys
from pathlib import Path
folder=Path(sys.argv[1]); reference=json.loads((folder/'preflight-serial.json').read_text())
for p in [1,2,3,4,6,12]:
    row=json.loads((folder/('preflight-p%d.json'%p)).read_text())
    assert (row['p'],row['t'])==(p,12//p)
    for key in ['data_fingerprint','init_indices','counts','labels']:
        assert row[key]==reference[key], (p,key)
    assert len(row['centers'])==len(reference['centers'])
    assert all(math.isclose(a,b,rel_tol=1e-8,abs_tol=1e-10) for a,b in zip(row['centers'],reference['centers']))
    assert math.isclose(row['sse'],reference['sse'],rel_tol=1e-8,abs_tol=1e-10)
(folder/'preflight-check.json').write_text(json.dumps(dict(configurations=6,numerical_check='pass',placement_check='pass'))+'\n')
PY

echo 'Stage 3: Fixed 12-core V3 hybrid layouts; 5 interleaved repeats.'
atlas_launcher=$("$atlas_python" - "$atlas_python" "$PBS_O_WORKDIR" "$atlas_results" "$PBS_NODEFILE" <<'PY'
import shlex,sys
py,work,out,nodefile=sys.argv[1:]
print(shlex.join([py,work+'/atlas-hybrid-launch.py','run','--plan',out+'/layout-plan.json',
                  '--p','{p}','--t','{t}','--probe',work+'/build/atlas-thread-probe',
                  '--output',out+'/placements','--nodefile',nodefile,'--']))
PY
)
"$atlas_python" scripts/benchmark.py --suite hybrid --total-cores 12 --processes 1,2,3,4,6,12 \
  --n 1000000 --d 32 --k 32 --iterations 20 --warmup 2 --repeats 5 --timeout 300 \
  --launcher "$atlas_launcher" --output "$atlas_results/hybrid.jsonl"
"$atlas_python" scripts/summarize.py "$atlas_results/hybrid.jsonl" --output "$atlas_results/hybrid.csv"

echo 'Stage 4: Audit every formal launch and all 30 measurements.'
"$atlas_python" - "$atlas_results" <<'PY' > "$atlas_results/experiment-check.json"
from collections import defaultdict
import importlib.util,json,math,sys
from pathlib import Path
spec=importlib.util.spec_from_file_location('hybrid','atlas-hybrid-launch.py')
hybrid=importlib.util.module_from_spec(spec);spec.loader.exec_module(hybrid)
folder=Path(sys.argv[1]);plan=json.loads((folder/'layout-plan.json').read_text())
rows=[json.loads(line) for line in (folder/'hybrid.jsonl').read_text().splitlines() if line.strip()]
groups=defaultdict(list)
assert len(rows)==30 and len({r['placement_id'] for r in rows})==30
reference=rows[0]
for row in rows:
    p,t=row['p'],row['t'];groups[(p,t)].append(row)
    assert p*t==12 and row['variant']=='v3' and row['communication']=='allreduce'
    assert (row['n'],row['d'],row['k'],row['seed'],row['iterations'],row['warmup'])==(1000000,32,32,42,20,2)
    assert row['nodes']==1 and row['mode']=='fixed' and not row['diagnostic']
    assert row['data_fingerprint']==reference['data_fingerprint'] and row['init_indices']==reference['init_indices']
    assert sum(row['counts'])==1000000
    assert math.isclose(row['sse'],reference['sse'],rel_tol=1e-10)
    assert row['placement_check']=='pass'
    directory=folder/'placements'/row['placement_id']
    records=[json.loads((directory/('rank-%d.json'%r)).read_text()) for r in range(p)]
    hybrid.verify_records(plan,p,t,records)
    assert json.loads((directory/'check.json').read_text())['placement_check']=='pass'
assert set(groups)==set(hybrid.PAIRS)
assert all(sorted(r['repeat'] for r in group)==list(range(5)) for group in groups.values())
print(json.dumps(dict(records=30,configurations=6,repeats=5,numerical_check='pass',placement_check='pass',
                     identical_counts=all(r['counts']==reference['counts'] for r in rows),
                     cross_socket_ranks={p:c['cross_socket_ranks'] for p,c in plan['configurations'].items()})))
PY
cat "$atlas_results/experiment-check.json"
echo "Hybrid job finished. Results: $atlas_results"
