#!/bin/bash
#PBS -N p3_validate
#PBS -q parallel
#PBS -j oe
#PBS -l select=1:ncpus=12:mpiprocs=12:ompthreads=1:mem=8gb
#PBS -l walltime=00:30:00

# Single-node validation and pilot only; review allocation/binding reports
# before using the resulting timings in a formal scaling study.
set -eo pipefail
cd "$PBS_O_WORKDIR"
atlas_results="$PBS_O_WORKDIR/results/atlas-validation.$PBS_JOBID"
mkdir -p "$atlas_results"
trap 'atlas_status=$?; printf "exit_status=%s\n" "$atlas_status" > "$atlas_results/status.txt"' EXIT

source /etc/profile.d/modules.sh
module purge
module load miniconda/4.12
module load openmpi/4.1.2
module load gcc/9.2.0

atlas_cxx=$(command -v g++)
atlas_gcc_version=$("$atlas_cxx" -dumpfullversion -dumpversion)
if [[ "$atlas_gcc_version" != 9.2.0 ]]; then
  echo "Expected GCC 9.2.0; found $atlas_gcc_version at $atlas_cxx" >&2
  exit 1
fi
export OMPI_CXX="$atlas_cxx"
atlas_python=$(command -v python3)
"$atlas_python" -c 'import sys; print(sys.version); sys.exit(0 if sys.version_info >= (3, 8) else "Python 3.8+ is required; check miniconda/4.12")'

{
  hostname
  module list
  "$atlas_cxx" --version
  mpicxx --showme:command
  mpirun --version
  "$atlas_python" --version
  echo "PBS allocation slots:"
  cat "$PBS_NODEFILE"
  echo "CPU topology:"
  lscpu
  echo "Batch shell affinity:"
  taskset -pc $$
} > "$atlas_results/environment.txt" 2>&1
cat "$atlas_results/environment.txt"

echo 'Stage 1: Rebuild using the verified compiler selection.'
make -B all CXX="$atlas_cxx" MPICXX=mpicxx

echo 'Stage 2: Run all numerical and experiment-tool tests, including real MPI.'
export TEST_MPI=1
export MPIEXEC=mpirun
export MPIEXEC_FLAGS='--bind-to none'
export OMP_DYNAMIC=FALSE
unset OMP_NUM_THREADS OMP_PLACES OMP_PROC_BIND KMEANS_BINDING_NOTE
"$atlas_python" -m unittest discover -s tests -v 2>&1 | tee "$atlas_results/correctness.log"

echo 'Stage 3: Probe CPU binding for 3 ranks x 4 threads.'
export OMP_PLACES=cores
export OMP_PROC_BIND=close
export KMEANS_BINDING_NOTE='single-node pilot; slot:PE=T, bind-to core; inspect binding reports and PBS allocation'
if mpirun -np 3 --map-by slot:PE=4 --bind-to core --nooversubscribe --report-bindings \
    ./build/kmeans_mpi --n 10000 --d 8 --k 16 --iterations 5 --threads 4 --variant v3 \
    > "$atlas_results/binding-probe.json" 2> "$atlas_results/binding-probe.stderr.log"; then
  cat "$atlas_results/binding-probe.stderr.log"
  cat "$atlas_results/binding-probe.json"
else
  cat "$atlas_results/binding-probe.stderr.log" >&2
  exit 1
fi

echo 'Stage 4: Pilot with N=100000, D=32, K=32, 20 iterations, 3 repeats.'
"$atlas_python" scripts/benchmark.py --suite smoke \
  --processes 1,3 --threads 4 --n 100000 --d 32 --k 32 \
  --iterations 20 --warmup 2 --repeats 3 --timeout 300 \
  --launcher 'mpirun -n {p} --map-by slot:PE={t} --bind-to core --nooversubscribe --report-bindings' \
  --output "$atlas_results/pilot.jsonl"
"$atlas_python" scripts/summarize.py "$atlas_results/pilot.jsonl" \
  --output "$atlas_results/pilot.csv"

echo "Validation and pilot finished. Results: $atlas_results"
echo 'Check correctness.log, environment.txt and binding reports before formal benchmarking.'
