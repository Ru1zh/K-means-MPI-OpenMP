#!/bin/bash
#PBS -N p3_strong
#PBS -q parallel
#PBS -j oe
#PBS -l select=1:ncpus=12:mpiprocs=12:ompthreads=1:mem=8gb
#PBS -l walltime=00:30:00

set -eo pipefail
cd "$PBS_O_WORKDIR"
atlas_results="$PBS_O_WORKDIR/results/atlas-strong.$PBS_JOBID"
mkdir -p "$atlas_results"
trap 'atlas_status=$?; printf "exit_status=%s\n" "$atlas_status" > "$atlas_results/status.txt"' EXIT

source /etc/profile.d/modules.sh
module purge
module load miniconda/4.12
module load openmpi/4.1.2
module load gcc/9.2.0
atlas_cxx=$(command -v g++)
atlas_python=$(command -v python3)
[[ $("$atlas_cxx" -dumpfullversion -dumpversion) == 9.2.0 ]]
export OMPI_CXX="$atlas_cxx"
"$atlas_python" -c 'import sys; print(sys.version); sys.exit(0 if sys.version_info >= (3, 8) else "Python 3.8+ required")'

{
  hostname
  module list
  "$atlas_cxx" --version
  mpicxx --showme:command
  mpirun --version
  "$atlas_python" --version
  lscpu
  taskset -pc $$
  cat "$PBS_NODEFILE"
} > "$atlas_results/environment.txt" 2>&1

echo 'Stage 1: Rebuild on the compute node.'
make -B all CXX="$atlas_cxx" MPICXX=mpicxx

echo 'Stage 2: Check OS CPU affinity within the PBS allocation.'
export OMP_DYNAMIC=FALSE
export OMP_PLACES=cores
export OMP_PROC_BIND=close
unset OMP_NUM_THREADS
"$atlas_python" atlas-affinity.py snapshot --expected-cores 12 > "$atlas_results/allocation.json"
for atlas_p in 1 2 3 4 6 12; do
  if mpirun --hostfile "$PBS_NODEFILE" -n "$atlas_p" \
      --map-by slot:PE=1 --bind-to core --nooversubscribe --report-bindings \
      "$atlas_python" "$PBS_O_WORKDIR/atlas-affinity.py" rank \
      > "$atlas_results/affinity-p$atlas_p.jsonl" 2> "$atlas_results/affinity-p$atlas_p.stderr.log"; then
    echo "Recorded affinity for P=$atlas_p."
  else
    cat "$atlas_results/affinity-p$atlas_p.stderr.log" >&2
    exit 1
  fi
done
"$atlas_python" atlas-affinity.py verify --directory "$atlas_results" > "$atlas_results/affinity-verified.json"
atlas_baseline_cpu=$("$atlas_python" -c 'import json,sys; print(json.load(open(sys.argv[1]))["baseline_cpu"])' "$atlas_results/affinity-verified.json")
taskset --cpu-list "$atlas_baseline_cpu" "$atlas_python" -c \
  'import json,os,sys; actual=sorted(os.sched_getaffinity(0)); assert actual==[int(sys.argv[1])], actual; print(json.dumps({"cpus":actual}))' \
  "$atlas_baseline_cpu" > "$atlas_results/serial-affinity.json"
echo "Verified serial baseline OS CPU: $atlas_baseline_cpu"

echo 'Stage 3: Fixed-work strong scaling; V3, one thread/rank, 5 repeats.'
export KMEANS_BINDING_NOTE="PBS OS CPU set audited; MPI one core/rank; V0 taskset CPU=$atlas_baseline_cpu; see affinity-verified.json"
atlas_launcher="mpirun --hostfile \"$PBS_NODEFILE\" -n {p} --map-by slot:PE=1 --bind-to core --nooversubscribe --report-bindings"
atlas_serial_launcher="taskset --cpu-list $atlas_baseline_cpu"
"$atlas_python" scripts/benchmark.py --suite strong --processes 1,2,3,4,6,12 --threads 1 \
  --n 1000000 --d 32 --k 32 --iterations 20 --warmup 2 --repeats 5 --timeout 300 \
  --launcher "$atlas_launcher" --serial-launcher "$atlas_serial_launcher" \
  --output "$atlas_results/strong.jsonl"
"$atlas_python" scripts/summarize.py "$atlas_results/strong.jsonl" --output "$atlas_results/strong.csv"

echo 'Stage 4: Check measurement completeness and numerical consistency.'
"$atlas_python" - "$atlas_results/strong.jsonl" <<'PY' > "$atlas_results/experiment-check.json"
from collections import defaultdict
import json,math,sys
rows=[json.loads(line) for line in open(sys.argv[1]) if line.strip()]
groups=defaultdict(list)
for row in rows:
    groups[(row['variant'],row['p'],row['t'])].append(row)
expected={('v0',1,1)} | {('v3',p,1) for p in [1,2,3,4,6,12]}
assert set(groups)==expected and len(rows)==35
for group in groups.values():
    assert sorted(row['repeat'] for row in group)==list(range(5))
reference=next(row for row in rows if row['variant']=='v0')
for row in rows:
    assert (row['n'],row['d'],row['k'],row['iterations'],row['warmup'])==(1000000,32,32,20,2)
    assert row['nodes']==1 and row['p']*row['t']<=12
    assert row['data_fingerprint']==reference['data_fingerprint']
    assert row['init_indices']==reference['init_indices']
    assert sum(row['counts'])==row['n']
    assert math.isclose(row['sse'],reference['sse'],rel_tol=1e-10)
print(json.dumps(dict(records=35,configurations=7,repeats=5,numerical_check='pass',
                     identical_counts=all(row['counts']==reference['counts'] for row in rows))))
PY
cat "$atlas_results/experiment-check.json"
echo "Strong-scaling job finished. Results: $atlas_results"
