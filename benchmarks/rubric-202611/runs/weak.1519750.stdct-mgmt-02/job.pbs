#!/bin/bash
#PBS -N km-weak
#PBS -q auto
#PBS -l select=4:ncpus=64:mpiprocs=64:mem=8gb
#PBS -l place=scatter:excl
#PBS -l walltime=08:00:00
#PBS -j oe
set -euo pipefail
cd "$PBS_O_WORKDIR"
# Set KMEANS_ENV_FILE in qsub -v. This file must load the verified compiler/MPI/CUDA modules.
: "${KMEANS_ENV_FILE:?Provide an absolute path to your cluster environment setup file}"
source "$KMEANS_ENV_FILE"
RUN="$PBS_O_WORKDIR/artifacts/rubric-202611/weak.${PBS_JOBID}"
mkdir -p "$RUN"
cp "$0" "$RUN/job.pbs"
exec > >(tee "$RUN/job.stdout") 2>&1
# Stage before building: simultaneous jobs must never link into a shared build/.
python3 hpc/rubric_stage.py --output "$RUN/source"
cd "$RUN/source"
python3 hpc/rubric_probe.py --cores-per-node 64 --output "$RUN/probe" 
make all 
python3 hpc/rubric_preflight.py --allocation "$RUN/probe/allocation.json"  --require-256
python3 scripts/rubric_campaign.py --suite weak --cores-per-node 64 --allocation "$RUN/probe/allocation.json" --output "$RUN/measurements"
