#!/bin/bash
#PBS -N km-gpu
#PBS -q auto
#PBS -l select=1:ncpus=8:mpiprocs=8:ngpus=1:mem=8gb
#PBS -l place=scatter:excl
#PBS -l walltime=08:00:00
#PBS -j oe
set -euo pipefail
cd "$PBS_O_WORKDIR"
# Set KMEANS_ENV_FILE in qsub -v. This file must load the verified compiler/MPI/CUDA modules.
: "${KMEANS_ENV_FILE:?Provide an absolute path to your cluster environment setup file}"
source "$KMEANS_ENV_FILE"
RUN="$PBS_O_WORKDIR/artifacts/rubric-202611/gpu.${PBS_JOBID}"
mkdir -p "$RUN"
cp "$0" "$RUN/job.pbs"
exec > >(tee "$RUN/job.stdout") 2>&1
# Stage before building: simultaneous jobs must never link into a shared build/.
python3 hpc/rubric_stage.py --output "$RUN/source"
cd "$RUN/source"
python3 hpc/rubric_probe.py --cores-per-node 8 --output "$RUN/probe" --gpu
make all cuda CUDA_HOME="${CUDA_HOME:?Set CUDA_HOME in environment file}" CUDA_ARCH="${CUDA_ARCH:?Set CUDA_ARCH from device probe}"
python3 hpc/rubric_preflight.py --allocation "$RUN/probe/allocation.json" --gpu 
python3 scripts/rubric_campaign.py --suite gpu --cores-per-node 8 --allocation "$RUN/probe/allocation.json" --output "$RUN/measurements"
